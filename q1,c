#include <stdio.h>

int main() {
    float prog_marks, math_marks, ai_marks, attendance;
    float total_avg;

    printf("Enter Programming marks: ");
    scanf("%f", &prog_marks);

    printf("Enter Mathematics marks: ");
    scanf("%f", &math_marks);

    printf("Enter AI marks: ");
    scanf("%f", &ai_marks);

    printf("Enter Attendance percentage: ");
    scanf("%f", &attendance);

    // Checking primary conditions first using nested structure
    if (prog_marks >= 50.0) {
        if (math_marks >= 50.0) {
            if (ai_marks >= 50.0) {
                if (attendance >= 75.0) {
                    total_avg = (prog_marks + math_marks + ai_marks) / 3.0;
                    printf("Student is Eligible.\n");
                    printf("Average Marks: %.2f\n", total_avg);

                    if (total_avg >= 80.0) {
                        printf("Performance: Excellent\n");
                    } else if (total_avg >= 70.0) {
                        printf("Performance: Very Good\n");
                    } else if (total_avg >= 60.0) {
                        printf("Performance: Good\n");
                    } else if (total_avg >= 50.0) {
                        printf("Performance: Satisfactory\n");
                    } else {
                        printf("Performance: Poor\n");
                    }
                } else {
                    printf("Student Is Not Eligible\n");
                }
            } else {
                printf("Student Is Not Eligible\n");
            }
        } else {
            printf("Student Is Not Eligible\n");
        }
    } else {
        printf("Student Is Not Eligible\n");
    }

    return 0;
}
